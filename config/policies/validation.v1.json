    { "code": "INV-004", "errorCode": "SC002", "severity": "warning",  "message": "Σcomponents와 rawScore의 차이가 허용오차를 넘었다" },
    { "code": "INV-005", "errorCode": "CF002", "severity": "warning",  "message": "confidence.value가 0~100 범위를 벗어났다" },
    { "code": "INV-006", "errorCode": "CF002", "severity": "warning",  "message": "coverage/freshness/quality가 0~100 또는 null이 아니다" },
    { "code": "INV-007", "errorCode": "CF001", "severity": "warning",  "message": "confidence.value가 confidencePolicyVersion 공식과 불일치한다" },
    { "code": "AX001",   "errorCode": "AX001", "severity": "warning",  "message": "criteria에 있는 축의 스코어러가 없다" },
    { "code": "AX002",   "errorCode": "AX002", "severity": "critical", "message": "categoryWeights가 비어 있다" }
  ]
