node_modules/
__pycache__/
*.pyc

.env
.env.*
*.key
.token_cache*.json
deploy.conf
config.yaml

# A2a 샤드 중간 산출 — artifact로만 넘기고 저장소에는 남기지 않는다.
# 부분 수집물이 커밋되면 finalize 없이도 산출이 있는 것처럼 보인다.
data/backfill/price/_shards/
# A5 본백필도 같은 이유(네트워크 없는 순수 계산이라 A2b식 커밋 재개도 불필요 —
# 실패한 샤드는 그냥 재실행한다, scripts/build-a5-backfill.js 주석 참고).
data/backfill/scores/_shards/
.dep-blocker-test/

# Paper Trading Engine 포지션 상태 — 실행마다 바뀌는 로컬 상태다. 연구
# 산출물이 아니라 재시작 안전성을 위한 캐시라 커밋 대상이 아니다.
research/strategy-lab/data/paper/

# 자격증명 메모 파일 - 저장소 안에 두지 않는다. 실수로 들어와도 커밋되지 않게 막는다.
# 범위를 좁게 둔다. '*secret*' 같은 넓은 패턴은 나중에 docs/secret-정책.md 같은
# 정상 문서를 조용히 숨긴다 - 무시는 실패하지 않으므로 눈치채기 어렵다.
# core.ignorecase=true라 대소문자를 가리지 않는다. '*KIS*Key*'는 자기를 다루는
# 도구인 scripts/setup-kis-key.py까지 삼켰다. 넓은 패턴은 조용히 과녁을 넘는다.
*.docx
/KIS*Key*
*appkey*
*apikey*
!scripts/setup-kis-key.py

# 분봉 Raw는 저장소 밖이다(MN-1.0 §1). 로컬 실행은 진단용이며 커밋 대상이 아니다.
# manifest(data/backfill/minute/manifest)는 반대로 유일한 커밋 대상이라 무시하지 않는다.
data/minute/

# Obsidian 편집기 개인 설정(워크스페이스 상태 등, 기기마다 다르다) — 추적 안 함.
# gitignore해도 Obsidian 사용에는 영향 없다(파일시스템만 읽고 git을 모른다).
.obsidian/

# graphify 생성 캐시 — `graphify update .`로 언제든 재생성 가능. 추적 안 함.
# gitignore해도 graphify 사용에는 영향 없다(로컬 디스크에서 그대로 읽고 쓴다).
graphify-out/
