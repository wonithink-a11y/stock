[Unit]
# autotrader 웹 화면(읽기 전용) — 폰에서 상태를 본다. 설치·설명: docs/control/autotrader-웹화면-설치-가이드.md
#
# ★ 이 서비스에는 EnvironmentFile 이 **없다**. 그리고 홈 디렉터리를 비워(tmpfs) KIS 키가 든 .env 를 아예 못 보게 한다 —
#   웹 프로세스는 키를 볼 수 없다(화면이 뚫려도 키는 안전). 키는 스냅샷 작업(autotrader-snapshot.service)만 쓴다.
# ★ 127.0.0.1 에만 붙는다. 바깥(HTTPS)은 **기존 nginx**(wonithink-stock.duckdns.org, certbot 인증서)가 /autotrader/ 경로로 넘겨준다
#   (deploy/nginx-autotrader.location.example). 같은 도메인의 다른 서비스와 섞이지 않게 접두사 밖 경로는 404 를 낸다.
# 비밀번호·인증앱 설정은 서버에서 한 번: python3 -m autotrader --config <설정> web-setup
Description=autotrader web view (read-only, no broker keys)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/collector
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/collector-venv/bin/python3 -m autotrader --config /home/ubuntu/collector-venv/autotrader/autotrader.local.json serve --host 127.0.0.1 --port 8787 --base-path /autotrader
Restart=on-failure
RestartSec=5

# ★ 2026-09-22 보안 검토(M5): 홈 전체를 읽을 수 있었다(.env 하나만 막혀 있었고, 같은 폴더의 키 백업 .env.bak-*·
#   KIS 토큰 캐시·DuckDNS 토큰·~/.ssh 는 열려 있었다). 이제 홈은 빈 tmpfs 이고 **필요한 것만** 붙인다:
#   코드(읽기)·파이썬 venv 실행부(읽기)·autotrader 설정/프로필(읽기)·상태 폴더(쓰기). 그 안의 토큰 캐시도 막는다.
#   새 비밀 파일이 생겨도 여기 목록에 없으면 안 보인다(허용목록 방식).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/collector /home/ubuntu/collector-venv/bin /home/ubuntu/collector-venv/lib /home/ubuntu/collector-venv/pyvenv.cfg /home/ubuntu/collector-venv/autotrader
BindPaths=/home/ubuntu/collector-venv/autotrader/state
InaccessiblePaths=-/home/ubuntu/collector/scripts/.vts_token_cache.json -/home/ubuntu/collector/scripts/.env -/home/ubuntu/collector/.env -/home/ubuntu/collector/.token_cache_kis_vts.json -/home/ubuntu/collector/.token_cache_kis_vts_futures.json -/home/ubuntu/collector-venv/autotrader/state/tokens

StandardOutput=append:/home/ubuntu/collector-venv/logs/autotrader-web.log
StandardError=append:/home/ubuntu/collector-venv/logs/autotrader-web.log

[Install]
WantedBy=multi-user.target
