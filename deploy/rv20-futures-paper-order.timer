[Unit]
Description=RV20 futures sizing rule paper order daily timer

[Timer]
# KOSPI200 선물 주간 정규장 09:00 개장 - 몇 분 뒤(09:05) 한 번만.
# 이 규칙은 일봉 종가 기준 신호를 다음날 시가부터 적용하는 설계라(동결
# 메모 §1.3) 장중 반복 폴링이 필요 없다 - KR 주식 페이퍼엔진(10분 간격)과
# 다른 이유.
OnCalendar=Mon..Fri *-*-* 09:05:00
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
