[Unit]
# autotrader(사용자 키·전략 교체형 자동매매) 1회 실행 — README.md §5.
#
# ★ 이 파일은 **dry-run 으로 배포된다**(--execute 없음). 주문을 켜는 것은 사용자가 VM 에서 직접 한다:
#   `sudo systemctl edit autotrader.service` 로 ExecStart 를 비우고 --execute 를 붙여 다시 쓴다.
#   실전이면 같은 자리에 Environment=AUTOTRADER_ALLOW_LIVE=I-ACCEPT-REAL-TRADES 를 둔다(설정 파일에는 두지 않는다).
#
# 설정·키는 저장소 밖 ~/collector-venv/autotrader/ 에 둔다(VM 은 git pull 만 한다 — 추적 파일을 고치면 pull 이 막힌다):
#     mkdir -p ~/collector-venv/autotrader/state
#     autotrader.local.json   (config.example.json 복사, state_dir 을 ~/collector-venv/autotrader/state 로)
#     키는 EnvironmentFile(~/collector-venv/.env): KIS_VTS_* 또는 KIS_LIVE_*
# 시크릿을 이 파일에 쓰지 않는다.
Description=autotrader (strategy plug-in auto-trading, dry-run by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/collector
EnvironmentFile=/home/ubuntu/collector-venv/.env
ExecStartPre=/usr/bin/git -C /home/ubuntu/collector pull --ff-only
ExecStart=/home/ubuntu/collector-venv/bin/python3 -m autotrader --config /home/ubuntu/collector-venv/autotrader/autotrader.local.json run

StandardOutput=append:/home/ubuntu/collector-venv/logs/autotrader.log
StandardError=append:/home/ubuntu/collector-venv/logs/autotrader.log

NoNewPrivileges=yes
PrivateTmp=yes
