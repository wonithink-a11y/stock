[Unit]
Description=Pull collector repo daily (before market open)

# 타이머 자신의 실패도 알린다. 서비스의 OnFailure 로는 안 잡힌다 — 유닛 파일이
# 깨지면(설치 때 경로 플레이스홀더가 치환 안 된 채 남는 식으로) 로드가 막혀
# **실행 자체가 없고**, 실패하는 것은 타이머 쪽이다(`Failed to queue unit startup job`). 2026-09-20 에 실제로 그렇게
# 분봉 수집이 조용히 멈췄다. 타이머 OnFailure 가 이 모양에서 발화함은 실측 확인.
OnFailure=unit-failure-notify@%n.service

[Timer]
# 06:30 KST. 두 가지를 피해 고른 시각이다.
#   - 장중(09:00~15:30)을 피한다: paper-trading-poll 이 10분마다 돌고, 그 안에서
#     전략별로 run_monthly_rebalance.py 를 하나씩 subprocess 로 띄운다. pull 이
#     그 사이에 끼면 한 실행 안에서 전략마다 다른 버전의 코드가 돌 수 있다.
#   - 전날 밤 Actions 커밋(selection 갱신·분봉 승격) 이후여야 한다.
# 하루 한 번이면 충분하다 - 급한 코드 반영은 사람이 직접 pull 한다.
OnCalendar=*-*-* 06:30:00

# VM 이 꺼져 있었거나 트리거를 놓쳤으면 다음 부팅에 따라잡는다. 월초 selection
# 갱신을 놓치면 그 달이 통째로 안 도므로 이건 특히 중요하다.
Persistent=true
RandomizedDelaySec=120

Unit=collector-pull.service

[Install]
WantedBy=timers.target
