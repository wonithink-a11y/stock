# nginx 예시 — 기존 server { listen 443 ssl; server_name wonithink-stock.duckdns.org; ... } 블록 **안에** 넣는다.
# (certbot 이 이미 인증서를 발급했다. 기존 location 들은 그대로 두고 이 두 개만 **추가**한다. 이 파일은 예시일 뿐이다.)
#
# X-Forwarded-For 를 $remote_addr 로 **덮어쓴다**(붙이지 않는다) — 접속자가 가짜 IP 를 보내도 잠금이 진짜 IP 로 걸린다.
    location = /autotrader { return 301 /autotrader/; }
    location /autotrader/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }
