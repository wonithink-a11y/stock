[Unit]
Description=Intraday big-move alert every 10 minutes in KR/US sessions (KST)
OnFailure=unit-failure-notify@%n.service

[Timer]
# VM 시간대는 Asia/Seoul. 스크립트가 열린 시장을 다시 판별하므로 창은 넉넉히 잡는다.
OnCalendar=Mon..Fri *-*-* 09..15:00/10
# 미국장 22:30~05:00 KST(서머타임) / 23:30~06:00(표준시) - 금요일 밤 장은 토요일 새벽에 끝난다
OnCalendar=Mon..Fri *-*-* 22,23:00/10
OnCalendar=Tue..Sat *-*-* 00..06:00/10

[Install]
WantedBy=timers.target
