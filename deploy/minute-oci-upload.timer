[Unit]
Description=Minute OCI Object Storage upload timer (MN-1.0)

# 타이머 자신의 실패도 알린다. 서비스의 OnFailure 로는 안 잡힌다 — 유닛 파일이
# 깨지면(설치 때 경로 플레이스홀더가 치환 안 된 채 남는 식으로) 로드가 막혀
# **실행 자체가 없고**, 실패하는 것은 타이머 쪽이다(`Failed to queue unit startup job`). 2026-09-20 에 실제로 그렇게
# 분봉 수집이 조용히 멈췄다. 타이머 OnFailure 가 이 모양에서 발화함은 실측 확인.
OnFailure=unit-failure-notify@%n.service

[Timer]
# 시각은 install-oci-upload.sh가 이 머신의 로컬 시간대로 환산해 채운다.
#   18:00 KST   두 번째 수집 실행(17:40 KST)이 끝난 뒤
# 정확히 그 시각에 맞출 필요는 없다 - upload-minute-oci.py는 로컬에 통과
# manifest가 있는데 아직 안 올라간 날짜를 오래된 것부터 밀어서 올린다
# (기본 --days 5) - 하루 놓쳐도 다음 실행이 저절로 따라잡는다.
OnCalendar=*-*-* @RUN@:00

# VM이 꺼져 있었거나 트리거를 놓쳤으면 다음 부팅에 따라잡는다.
Persistent=true

# 같은 시각에 여러 작업이 겹치지 않게 흩는다.
RandomizedDelaySec=180

Unit=minute-oci-upload.service

[Install]
WantedBy=timers.target
