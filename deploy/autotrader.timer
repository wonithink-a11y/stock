[Unit]
Description=autotrader daily timer (edit the schedule to fit your strategy)

[Timer]
# 기본: 평일 09:10 KST(국내 장 개장 직후) 1회. VM 시각대 = KST 전제(다른 타이머와 동일).
# 해외 전략이면 미국 개장(서머 22:30 / 표준 23:30 KST) 전으로 옮긴다. 전략이 하루 여러 번 필요하면 OnCalendar 를 추가한다.
OnCalendar=Mon..Fri *-*-* 09:10:00
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
