[Unit]
Description=Paper trading engine daily poll timer (pbr_value_v1, lowmom60_v1)

[Timer]
# 장중(09:00~15:50, kis-portfolio-holdings.timer와 같은 10분 간격) - 매수/매도
# 제출 후 체결 확인까지 며칠 걸릴 수 있어(poll_once 자체 설계, 비동기) 자주
# 확인해야 놓치지 않는다. 장마감 이후 회차는 신규 신호가 없어 그냥 같은
# 결과를 다시 확인하는 것뿐이라 해롭지 않다.
OnCalendar=Mon..Fri *-*-* 9..15:00/10:00
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
