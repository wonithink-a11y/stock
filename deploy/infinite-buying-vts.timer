[Unit]
Description=Infinite-buying sleeve paper-account daily timer

# 타이머 자신의 실패도 알린다. 서비스의 OnFailure 로는 안 잡힌다 — 유닛 파일이
# 깨지면(설치 때 경로 플레이스홀더가 치환 안 된 채 남는 식으로) 로드가 막혀
# **실행 자체가 없고**, 실패하는 것은 타이머 쪽이다(`Failed to queue unit startup job`). 2026-09-20 에 실제로 그렇게
# 분봉 수집이 조용히 멈췄다. 타이머 OnFailure 가 이 모양에서 발화함은 실측 확인.
OnFailure=unit-failure-notify@%n.service

[Timer]
# 21:30 KST(VM 시각대 = KST, 다른 타이머와 동일 전제). 미국 정규장 개장은 서머타임
# 22:30 / 표준시 23:30 KST — 어느 쪽이든 개장 전이다. 직전 세션 종가는 05:00 KST 에
# 확정돼 있다. 주문이 개장 전에 들어가 정규장에서 체결을 기다린다.
# 미국 휴장일에는 직전 종가로 다시 계획하고 접수한다 — 다음 실행이 잔존 주문을
# 취소하고 재접수하므로 쌓이지 않는다.
OnCalendar=Mon..Fri *-*-* 21:30:00
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
